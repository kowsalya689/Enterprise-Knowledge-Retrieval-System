# Copy to .env and fill in. Never commit .env.

# ---------------------------------------------------------------- API security
# Every key maps to a role (roles and their access tags are in data/roles.json).
# Create keys with:  python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=PUT-A-RANDOM-KEY-HERE:employee,PUT-ANOTHER-KEY-HERE:hr,PUT-A-THIRD-KEY-HERE:manager
# These keys are for scripts and the Swagger page (/docs) only. The web pages (Ask, Upload) have no key box.

# Role used by the web pages. Keep it at the least-privileged role. Empty = web pages switched off.
# The Docker ports are bound to 127.0.0.1, so only this computer can reach them. Do not expose the
# app to other computers with a web role set; use real logins (single sign-on) for that.
WEB_UI_ROLE=employee

# ---------------------------------------------------------------- Qdrant
# Qdrant Cloud (free cluster, nothing to install). URL must include https:// and :6333
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.cloud.qdrant.io:6333
QDRANT_API_KEY=YOUR-QDRANT-API-KEY
# or a local folder instead:  QDRANT_LOCAL_PATH=./qdrant_data  (leave QDRANT_URL empty)
QDRANT_COLLECTION=enterprise_kb

# ---------------------------------------------------------------- Embeddings
EMBEDDING_MODEL=nomic-ai/nomic-embed-text-v2-moe
EMBEDDING_DIM=768
EMBEDDING_DOC_PREFIX="search_document: "
EMBEDDING_QUERY_PREFIX="search_query: "
EMBEDDING_BATCH_SIZE=8
EMBEDDING_MAX_SEQ_LENGTH=512

# ---------------------------------------------------------------- Chunking
CHUNK_MAX_WORDS=380
CHUNK_OVERLAP_WORDS=30
TABLE_ROWS_PER_CHUNK=12
# DOCX page numbers need LibreOffice (see README). DOCX_PAGE_MODE=off skips them.
# SOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe

# ---------------------------------------------------------------- Retrieval
RETRIEVAL_TOP_K=4
# Minimum cosine score for a chunk to count as evidence. Calibrate it:
#   python -m app.evaluation.retrieval_eval      (prints a suggested value)
RELEVANCE_THRESHOLD=0.30
MIN_EVIDENCE_CHUNKS=1
MAX_CONTEXT_WORDS=900
STRICT_CITATIONS=false

# ---------------------------------------------------------------- Ollama (local LLM)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=300
OLLAMA_TEMPERATURE=0
# Context window: smaller = faster. It must fit MAX_CONTEXT_WORDS plus the answer.
OLLAMA_NUM_CTX=2048
# Longest answer in tokens
OLLAMA_NUM_PREDICT=300
# Keep the model loaded between questions (Ollama's default unloads it after 5 minutes)
OLLAMA_KEEP_ALIVE=24h

# ---------------------------------------------------------------- Redis cache
# Leave REDIS_URL empty (or CACHE_ENABLED=false) to run without a cache.
REDIS_URL=redis://localhost:6379/0
CACHE_ENABLED=true
CACHE_TTL_ANSWER_SECONDS=86400
# "Not found" answers are never cached.
# Semantic cache: reuse an answer for a differently worded question of the same meaning.
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.90
SEMANTIC_CACHE_MAX_ENTRIES=300
